# Copy this file to .env.local and fill in your own values.
# .env.local is git-ignored. NEVER commit real keys.

# ── Supabase (Dashboard → Project Settings → API) ───────────
# Public: these two are sent to the browser on purpose. The anon key is
# safe to expose ONLY because the database is locked down (see docs/).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SECRET: server only. Skips ALL database security. Never prefix with
# NEXT_PUBLIC_, never log it, never commit it. Used by the admin routes
# and proof-image links (lib/supabase-admin.ts).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Optional ────────────────────────────────────────────────
# Without this key, "Generate Next-Day Plan" returns built-in SAMPLE quests
# (the UI labels them as samples). With it, quests come from OpenAI.
OPENAI_API_KEY=
